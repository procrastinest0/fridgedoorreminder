# Copy to .env and fill in. Loaded by start-widget.sh on phone boot.
# Keep this file private: chmod 600 .env

# iCloud — use an app-specific password from appleid.apple.com
ICLOUD_USERNAME=your_apple_id@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Comma-separated, empty = all lists
REMINDER_LISTS=

# Google
GOOGLE_CALENDAR_IDS=primary

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Same value goes in pico/secrets.py
WIDGET_TOKEN=replace-me-with-random-string

# Locale
TIMEZONE=Asia/Kolkata

# Output sizing
MAX_EVENTS=5
MAX_REMINDERS=6
DAYS_AHEAD=7
CACHE_TTL=120
